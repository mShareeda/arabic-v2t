# ─────────────────────────────────────────────────────────────
#  انسخ هذا الملف إلى .env وعبّئ القيم
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── محرك تحويل الكلام إلى نص ────────────────────────────────
# القيم المتاحة: speechmatics | google | whisper
STT_PROVIDER=speechmatics

# مفتاح Speechmatics — من https://portal.speechmatics.com/api-keys
# الحساب التجريبي يمنح 480 دقيقة/شهر مجانًا + رصيد 100 دولار
SPEECHMATICS_API_KEY=

# منطقة الخدمة: eu2 (أوروبا) أو us (أمريكا)
SPEECHMATICS_REGION=eu2

# ── خادم البث الحي (gateway) ────────────────────────────────
GATEWAY_PORT=4000
GATEWAY_HOST=0.0.0.0

# سر مشترك بين الواجهة والـ gateway للتحقق من توكن الجلسة.
# ولّده بـ: openssl rand -base64 32
AUTH_SECRET=

# ── حدود النموذج الأولي (حماية من التكلفة) ──────────────────
MAX_SESSION_MINUTES=15
MAX_UPLOAD_MB=50
MAX_UPLOAD_MINUTES=30
USER_MONTHLY_QUOTA_MINUTES=60
MAX_CONCURRENT_SESSIONS=2

# ── قاعدة البيانات ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arabic_v2t

# ── الواجهة ─────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:4000
NEXTAUTH_URL=http://localhost:3000

# ── تلميع النص بنموذج لغوي (اختياري، مُعطّل افتراضيًا) ───────
ENABLE_LLM_POLISH=false
ANTHROPIC_API_KEY=
